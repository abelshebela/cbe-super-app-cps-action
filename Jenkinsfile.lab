pipeline {

    agent any

    environment {
        SERVICE_NAME = "cps-action"
        DOCKER_FILE_PATH = "scripts/Dockerfile"

        HARBOR_REGISTRY = "registry.eaglelionsystems.com"
        HARBOR_PROJECT  = "cbe-superapp"

        HARBOR_CREDS = credentials("harbor-creds")
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Go Build') {
            steps {
                sh '''
                go version
                go build ./...
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                docker build \
                  -f ${DOCKER_FILE_PATH} \
                  -t ${SERVICE_NAME}:build-${BUILD_NUMBER} .
                '''
            }
        }

        stage('Login to Harbor') {
            steps {
                sh '''
                echo "$HARBOR_CREDS_PSW" | docker login \
                    -u "$HARBOR_CREDS_USR" \
                    --password-stdin \
                    $HARBOR_REGISTRY
                '''
            }
        }

        stage('Tag Image') {
            steps {
                sh '''
                docker tag \
                ${SERVICE_NAME}:build-${BUILD_NUMBER} \
                ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:build-${BUILD_NUMBER}
                '''
            }
        }

        stage('Push Image') {
            steps {
                sh '''
                docker push \
                ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:build-${BUILD_NUMBER}
                '''
            }
        }

    }

    post {

        success {
            echo "BUILD SUCCESSFUL"
        }

        failure {
            echo "BUILD FAILED"
        }

        always {
            sh 'docker logout ${HARBOR_REGISTRY} || true'
        }
    }
}