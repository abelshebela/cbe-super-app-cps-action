pipeline {

    agent {
        kubernetes {

            yaml '''
apiVersion: v1
kind: Pod

spec:

  containers:

  - name: golang
    image: golang:1.26
    command:
    - cat
    tty: true
    workingDir: /home/jenkins/agent

    resources:
      requests:
        cpu: "500m"
        memory: "1Gi"
      limits:
        cpu: "2"
        memory: "2Gi"


  - name: docker
    image: docker:27-cli
    command:
    - cat
    tty: true
    workingDir: /home/jenkins/agent

    resources:
      requests:
        cpu: "500m"
        memory: "512Mi"
      limits:
        cpu: "1"
        memory: "1Gi"


    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock


  volumes:

  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock

'''
        }
    }


    environment {

        SERVICE_NAME = "cps-action"

        DOCKER_FILE_PATH = "scripts/Dockerfile"

        HARBOR_REGISTRY = "registry.eaglelionsystems.com"

        HARBOR_PROJECT = "cbe-superapp"

    }


    stages {


        stage('Checkout') {

            steps {

                checkout scm

            }

        }


        stage('Go Build') {

            steps {

                container('golang') {

                    sh '''
                    go version
                    go build ./...
                    '''

                }

            }

        }


        stage('Docker Build') {

            steps {

                container('docker') {

                    sh '''
                    docker build \
                    -f ${DOCKER_FILE_PATH} \
                    -t ${SERVICE_NAME}:build-${BUILD_NUMBER} .
                    '''

                }

            }

        }


        stage('Login Harbor') {

            steps {

                container('docker') {

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'harbor-creds',
                            usernameVariable: 'HARBOR_USER',
                            passwordVariable: 'HARBOR_PASSWORD'
                        )
                    ]) {


                        sh '''
                        echo "$HARBOR_PASSWORD" | docker login \
                        -u "$HARBOR_USER" \
                        --password-stdin \
                        ${HARBOR_REGISTRY}
                        '''

                    }

                }

            }

        }


        stage('Tag Image') {

            steps {

                container('docker') {

                    sh '''

                    docker tag \
                    ${SERVICE_NAME}:build-${BUILD_NUMBER} \
                    ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:build-${BUILD_NUMBER}

                    '''

                }

            }

        }


        stage('Push Image') {

            steps {

                container('docker') {

                    sh '''

                    docker push \
                    ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:build-${BUILD_NUMBER}

                    '''

                }

            }

        }

    }


    post {

        always {

            echo "Pipeline finished"

        }

    }

}