pipeline {

    agent {
        kubernetes {

            yaml '''
apiVersion: v1
kind: Pod

spec:

  containers:

  - name: golang
    image: golang:1.26

    command:
    - cat

    tty: true

    resources:
      requests:
        cpu: "500m"
        memory: "1Gi"

      limits:
        cpu: "2000m"
        memory: "2Gi"



  - name: docker
    image: docker:27-cli

    command:
    - cat

    tty: true

    resources:
      requests:
        cpu: "250m"
        memory: "512Mi"

      limits:
        cpu: "1000m"
        memory: "1Gi"


    volumeMounts:

    - name: docker-sock
      mountPath: /var/run/docker.sock



  volumes:

  - name: docker-sock

    hostPath:

      path: /var/run/docker.sock

'''
        }
    }



    options {

        skipDefaultCheckout()

        timeout(
            time: 30,
            unit: 'MINUTES'
        )

    }



    environment {


        SERVICE_NAME = "cps-action"


        DOCKERFILE = "scripts/Dockerfile"


        HARBOR_REGISTRY = "registry.eaglelionsystems.com"


        HARBOR_PROJECT = "cbe-superapp"



        IMAGE_TAG = "${BUILD_NUMBER}"


        GITLAB_USER = credentials('SHARED_GITLAB_USER')


        GITLAB_PAT = credentials('SHARED_GITLAB_PAT')

    }



    stages {



        stage('Checkout') {

            steps {

                checkout scm


                sh '''
                git config --global --add safe.directory "*"
                '''

            }

        }




        stage('Go Environment') {

            steps {

                container('golang') {


                    sh '''

                    echo "Checking Go"

                    go version


                    echo "Checking modules"

                    go env GOPATH


                    '''

                }

            }

        }




        stage('Go Build') {


            steps {


                container('golang') {


                    sh '''

                    set -e


                    echo "Configuring GitLab credentials for Go private modules..."

                    git config --global url."https://${GITLAB_USER}:${GITLAB_PAT}@gitlab.com/".insteadOf "https://gitlab.com/"

                    export GOPRIVATE="gitlab.com/bersufekadgetachew/*"

                    export CGO_ENABLED=1


                    echo "Downloading dependencies"


                    go mod download -x



                    echo "Building application"



                    go build \
                    -buildvcs=false \
                    -v \
                    ./... 2>&1 | tee build.log



                    echo "GO BUILD SUCCESS"

                    '''

                }

            }

        }





        stage('Docker Check') {


            steps {


                container('docker') {


                    sh '''

                    set -e


                    docker version


                    '''

                }

            }

        }




        stage('Docker Build') {


            steps {


                container('docker') {


                    sh '''

                    set -e


                    docker build \

                    -f ${DOCKERFILE} \

                    --build-arg GITLAB_USER=${GITLAB_USER} \

                    --build-arg GITLAB_PAT=${GITLAB_PAT} \

                    -t ${SERVICE_NAME}:${IMAGE_TAG} \

                    .


                    echo "DOCKER BUILD SUCCESS"


                    '''

                }

            }

        }





        stage('Harbor Login') {


            steps {


                container('docker') {


                    withCredentials([


                        usernamePassword(

                            credentialsId: 'harbor-creds',

                            usernameVariable: 'HARBOR_USERNAME',

                            passwordVariable: 'HARBOR_PASSWORD'

                        )


                    ]) {


                        sh '''

                        set -e


                        echo "$HARBOR_PASSWORD" | docker login \

                        ${HARBOR_REGISTRY} \

                        --username "$HARBOR_USERNAME" \

                        --password-stdin


                        '''

                    }


                }


            }


        }





        stage('Push Image') {


            steps {


                container('docker') {


                    sh '''

                    set -e



                    docker tag \

                    ${SERVICE_NAME}:${IMAGE_TAG} \

                    ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:${IMAGE_TAG}



                    docker push \

                    ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:${IMAGE_TAG}



                    echo "IMAGE PUSH SUCCESS"


                    '''

                }

            }


        }


    }




    post {


        success {


            echo """

            ===============================

            BUILD SUCCESSFUL


            Image pushed:

            ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:${IMAGE_TAG}


            ===============================

            """

        }




        failure {


            echo """

            ===============================

            BUILD FAILED


            Check the failed stage above


            ===============================

            """

        }




        always {


            echo "Pipeline completed"


        }


    }


}