pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: docker
    image: docker:27-cli
    command:
    - cat
    tty: true
    securityContext:
      privileged: true
      runAsUser: 0
    resources:
      requests:
        cpu: "500m"
        memory: "1Gi"
      limits:
        cpu: "1000m"
        memory: "2Gi"
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
'''
        }
    }

    options {
        skipDefaultCheckout()
        timeout(time: 15, unit: 'MINUTES')
    }

    environment {
        SERVICE_NAME = "cps-action"
        DOCKERFILE = "scripts/Dockerfile"
        HARBOR_REGISTRY = "registry.eaglelionsystems.com"
        HARBOR_PROJECT = "cbe-supperapp"
        IMAGE_TAG = "${BUILD_NUMBER}"
        FULL_IMAGE_PATH = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:${IMAGE_TAG}"
        DOCKER_BUILDKIT = '1'
    }

    stages {
        stage('Cloning Git') {
            steps {
                checkout scm
                sh 'git config --global --add safe.directory "*"'
            }
        }

        stage('Building Image and Define environmental variables') {
            steps {
                container('docker') {
                    script {
                        def gitlabUser = ""
                        def gitlabPat = ""
                        
                        try {
                            withCredentials([string(credentialsId: 'SHARED_GITLAB_USER', variable: 'GL_USER')]) {
                                gitlabUser = env.GL_USER
                            }
                        } catch (Exception e) {
                            echo "GitLab user credential not found: ${e.message}"
                        }
                        
                        try {
                            withCredentials([string(credentialsId: 'SHARED_GITLAB_PAT', variable: 'GL_PAT')]) {
                                gitlabPat = env.GL_PAT
                            }
                        } catch (Exception e) {
                            echo "GitLab token credential not found: ${e.message}"
                        }

                        sh """
                        set -e
                        echo "Building Docker image..."
                        docker build \
                            -f ${DOCKERFILE} \
                            --build-arg GITLAB_USER="${gitlabUser}" \
                            --build-arg GITLAB_PAT="${gitlabPat}" \
                            -t ${FULL_IMAGE_PATH} \
                            .
                        """
                    }
                }
            }
        }

        stage('Push Image to registry') {
            steps {
                container('docker') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'harbor_creds',
                            usernameVariable: 'HARBOR_USERNAME',
                            passwordVariable: 'HARBOR_PASSWORD'
                        )
                    ]) {
                        sh '''
                        set -e
                        echo "$HARBOR_PASSWORD" | docker login ${HARBOR_REGISTRY} --username "$HARBOR_USERNAME" --password-stdin
                        docker push ${FULL_IMAGE_PATH}
                        '''
                    }
                }
            }
        }

        stage('Update ArgoCD Repository') {
            steps {
                container('docker') {
                    script {
                        def githubUser = ""
                        def githubToken = ""
                        
                        try {
                            withCredentials([usernamePassword(credentialsId: 'GITHUB_CRED', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
                                githubUser = env.GH_USER
                                githubToken = env.GH_TOKEN
                            }
                        } catch (Exception e) {
                            echo "GitHub credentials not found: ${e.message}"
                        }

                        echo "Updating GitOps manifest repository with new image tag: ${IMAGE_TAG}"
                        
                        sh """
                        set -e
                        
                        # Install dependencies if missing (Alpine-based container)
                        if [ -f /etc/alpine-release ]; then
                            echo "Installing curl and bash..."
                            apk add --no-cache curl bash git
                        fi
                        
                        # 1. Clone the deployment repository using your GitHub PAT
                        git clone https://${githubUser}:${githubToken}@github.com/abelshebela/cbe-super-app-deployment.git /tmp/manifests
                        
                        cd /tmp/manifests/overlays/dev/cps-action
                        
                        # 2. Download the Kustomize CLI binary
                        curl -s "https://raw.githubusercontent.com/kubernetes-sigs/kustomize/master/hack/install_kustomize.sh" | bash
                        
                        # 3. Update the image tag safely
                        ./kustomize edit set image registry.eaglelionsystems.com/cbe-supperapp/cps-action=registry.eaglelionsystems.com/cbe-supperapp/cps-action:${IMAGE_TAG}
                        
                        # 4. Commit and Push back to GitHub
                        git config user.email "jenkins-ci@eaglelionsystems.com"
                        git config user.name "Jenkins CI"
                        
                        git add kustomization.yaml
                        git commit -m "chore(dev): update cps-action image tag to ${IMAGE_TAG}"
                        git push origin main
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo """
            ===============================
            BUILD SUCCESSFUL
            Image pushed: ${FULL_IMAGE_PATH}
            ArgoCD synchronization triggered.
            ===============================
            """
        }
        failure {
            echo """
            ===============================
            BUILD FAILED
            Check the failed stage logs above.
            ===============================
            """
        }
        always {
            echo "Declarative: Post Actions completed."
        }
    }
}