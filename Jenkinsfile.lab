pipeline {

    agent any

    environment {
        SERVICE_NAME = "cps-action"
        DOCKER_FILE_PATH = "scripts/Dockerfile"

        HARBOR_REGISTRY = "registry.eaglelionsystems.com"
        HARBOR_PROJECT  = "cbe-superapp"
    }


    stages {


        stage('Checkout') {
            steps {
                checkout scm
            }
        }


        stage('Go Build') {
            steps {
                sh '''
                go version
                go build ./...
                '''
            }
        }


        stage('Docker Build') {
            steps {
                sh '''
                docker build \
                  -f ${DOCKER_FILE_PATH} \
                  -t ${SERVICE_NAME}:build-${BUILD_NUMBER} .
                '''
            }
        }


        stage('Login to Harbor') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'harbor-creds',
                        usernameVariable: 'HARBOR_USER',
                        passwordVariable: 'HARBOR_PASSWORD'
                    )
                ]) {

                    sh '''
                    echo "$HARBOR_PASSWORD" | docker login \
                    -u "$HARBOR_USER" \
                    --password-stdin \
                    ${HARBOR_REGISTRY}
                    '''

                }
            }
        }


        stage('Tag Image') {
            steps {
                sh '''
                docker tag \
                ${SERVICE_NAME}:build-${BUILD_NUMBER} \
                ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:build-${BUILD_NUMBER}
                '''
            }
        }


        stage('Push Image') {
            steps {
                sh '''
                docker push \
                ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:build-${BUILD_NUMBER}
                '''
            }
        }


    }


    post {

        success {
            echo "BUILD SUCCESSFUL"
        }


        failure {
            echo "BUILD FAILED"
        }


        always {
            echo "Pipeline finished"
        }

    }

}