pipeline {

    agent {
        kubernetes {

            yaml '''
apiVersion: v1
kind: Pod

spec:

  containers:

  - name: golang
    image: golang:1.26

    command:
    - cat

    tty: true

    resources:
      requests:
        cpu: "500m"
        memory: "1Gi"

      limits:
        cpu: "2000m"
        memory: "2Gi"



  - name: docker
    image: docker:27-cli

    command:
    - cat

    tty: true

    resources:
      requests:
        cpu: "250m"
        memory: "512Mi"

      limits:
        cpu: "1000m"
        memory: "1Gi"


    volumeMounts:

    - name: docker-sock
      mountPath: /var/run/docker.sock



  volumes:

  - name: docker-sock

    hostPath:

      path: /var/run/docker.sock

'''
        }
    }



    options {

        skipDefaultCheckout()

        timeout(
            time: 30,
            unit: 'MINUTES'
        )

    }



    environment {


        SERVICE_NAME = "cps-action"


        DOCKERFILE = "scripts/Dockerfile"


        HARBOR_REGISTRY = "registry.eaglelionsystems.com"


        HARBOR_PROJECT = "cbe-superapp"



        IMAGE_TAG = "${BUILD_NUMBER}"

    }



    stages {



        stage('Checkout') {

            steps {

                checkout scm


                sh '''
                git config --global --add safe.directory "*"
                '''

            }

        }




        stage('Go Environment') {

            steps {

                container('golang') {


                    sh '''

                    echo "Checking Go"

                    go version


                    echo "Checking modules"

                    go env GOPATH


                    '''

                }

            }

        }




        stage('Go Build') {


            steps {
                container('golang') {
                    script {
                        def gitlabUser = ""
                        def gitlabPat = ""
                        try {
                            withCredentials([string(credentialsId: 'SHARED_GITLAB_USER', variable: 'GL_USER')]) {
                                gitlabUser = env.GL_USER
                            }
                        } catch (Exception e) {
                            echo "GitLab user credential (SHARED_GITLAB_USER) not found: ${e.message}"
                        }
                        try {
                            withCredentials([string(credentialsId: 'SHARED_GITLAB_PAT', variable: 'GL_PAT')]) {
                                gitlabPat = env.GL_PAT
                            }
                        } catch (Exception e) {
                            echo "GitLab token credential (SHARED_GITLAB_PAT) not found: ${e.message}"
                        }

                        if (gitlabUser && gitlabPat) {
                            sh """
                            set -e
                            echo "Configuring GitLab credentials for Go private modules..."
                            git config --global url."https://${gitlabUser}:${gitlabPat}@gitlab.com/".insteadOf "https://gitlab.com/"
                            export GOPRIVATE="gitlab.com/bersufekadgetachew/*"
                            export CGO_ENABLED=1
                            echo "Downloading dependencies"
                            go mod download -x
                            echo "Building application"
                            go build -buildvcs=false -v ./... 2>&1 | tee build.log
                            echo "GO BUILD SUCCESS"
                            """
                        } else {
                            sh '''
                            set -e
                            export CGO_ENABLED=1
                            echo "Downloading dependencies (unauthenticated)"
                            go mod download -x
                            echo "Building application"
                            go build -buildvcs=false -v ./... 2>&1 | tee build.log
                            echo "GO BUILD SUCCESS"
                            '''
                        }
                    }
                }
            }

        }





        stage('Docker Check') {


            steps {


                container('docker') {


                    sh '''

                    set -e


                    docker version


                    '''

                }

            }

        }




        stage('Docker Build') {


            steps {
                container('docker') {
                    script {
                        def gitlabUser = ""
                        def gitlabPat = ""
                        try {
                            withCredentials([string(credentialsId: 'SHARED_GITLAB_USER', variable: 'GL_USER')]) {
                                gitlabUser = env.GL_USER
                            }
                        } catch (Exception e) {
                            echo "GitLab user credential (SHARED_GITLAB_USER) not found: ${e.message}"
                        }
                        try {
                            withCredentials([string(credentialsId: 'SHARED_GITLAB_PAT', variable: 'GL_PAT')]) {
                                gitlabPat = env.GL_PAT
                            }
                        } catch (Exception e) {
                            echo "GitLab token credential (SHARED_GITLAB_PAT) not found: ${e.message}"
                        }

                        sh """
                        set -e
                        docker build \
                        -f ${DOCKERFILE} \
                        --build-arg GITLAB_USER="${gitlabUser}" \
                        --build-arg GITLAB_PAT="${gitlabPat}" \
                        -t ${SERVICE_NAME}:${IMAGE_TAG} \
                        .
                        echo "DOCKER BUILD SUCCESS"
                        """
                    }
                }
            }

        }





        stage('Harbor Login') {


            steps {


                container('docker') {


                    withCredentials([


                        usernamePassword(

                            credentialsId: 'harbor-creds',

                            usernameVariable: 'HARBOR_USERNAME',

                            passwordVariable: 'HARBOR_PASSWORD'

                        )


                    ]) {


                        sh '''

                        set -e


                        echo "$HARBOR_PASSWORD" | docker login \

                        ${HARBOR_REGISTRY} \

                        --username "$HARBOR_USERNAME" \

                        --password-stdin


                        '''

                    }


                }


            }


        }





        stage('Push Image') {


            steps {


                container('docker') {


                    sh '''

                    set -e



                    docker tag \

                    ${SERVICE_NAME}:${IMAGE_TAG} \

                    ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:${IMAGE_TAG}



                    docker push \

                    ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:${IMAGE_TAG}



                    echo "IMAGE PUSH SUCCESS"


                    '''

                }

            }


        }


    }




    post {


        success {


            echo """

            ===============================

            BUILD SUCCESSFUL


            Image pushed:

            ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${SERVICE_NAME}:${IMAGE_TAG}


            ===============================

            """

        }




        failure {


            echo """

            ===============================

            BUILD FAILED


            Check the failed stage above


            ===============================

            """

        }




        always {


            echo "Pipeline completed"


        }


    }


}