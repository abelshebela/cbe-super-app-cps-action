@startuml
title Donation Entity Model

class Donation {
  **Primary Key**
  --
  + ID : ObjectID
  --
  **Donation Info**
  --
  + DonationCode : string
  + Title : string
  + DonationDescription : string
  + CompanyID : ObjectID
  + CategoryID : ObjectID
  --
  **Financials**
  --
  + Target : int32
  + CurrentAmount : int32
  --
  **Media**
  --
  + CoverImage : string
  + DonationImages : []types.DonationImage
  --
  **Status & Schedule**
  --
  + IsFeatured : bool
  + Enabled : bool
  + IsDeleted : bool
  + StartDate : time.Time
  + EndDate : time.Time
  --
  **Timestamps**
  --
  + CreatedAt : time.Time
  + LastModifiedAt : time.Time
}

note right of Donation::Target
  Fundraising goal amount
end note

note bottom of Donation
  **Field Descriptions:**
  **DonationCode**: Unique identifier
  **CompanyID**: Organization receiving funds
  **CurrentAmount**: Total raised so far
end note
@enduml
