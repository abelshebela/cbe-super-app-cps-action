        }
        
        class PermissionHandler {
            +CreatePermission()
            +UpdatePermission()
            +GetPermission()
            +GetPermissions()
        }
        
        class PasswordRuleHandler {
            +CreateRule()
            +UpdateRule()
            +GetRule()
            +GetRules()
        }
        
        class PortalCardHandler {
            +CreateCard()
            +UpdateCard()
            +GetCard()
            +GetCards()
