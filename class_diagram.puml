        +BudgetDomain: BudgetService
        +BankDomain: BankService
        +DepartmentDomain: DepartmentService
        +PermissionDomain: PermissionService
        +MiniAppDomain: MiniAppService
    }
    
    package "Handlers" {
        class CPSActionHandler {
