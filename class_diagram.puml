    }
    
    package "Middleware" {
        class CPSPendingMiddleware {
            +Handle()
        }
        
        class ErrorMiddleware {
            +Handle()
        }
        
        class AuthMiddleware {
            +Handle()
        }
    }
}

package "Adapter Layer" <<Adapter>> {
    package "Inbound (HTTP)" {
        class HTTPRouter {
            +RegisterRoutes()
            +Use()
        }
        
        class Route {
            +Method: string
            +Path: string
            +Handler: func
            +Middlewares: []func
        }
        
        class ResponseUtil {
            +NotFoundHandler()
            +MethodNotAllowedHandler()
        }
    }
    
    package "Outbound (Persistence)" {
        class OutboundStore {
            +MongoDalDepartment: MongoDal
            +MongoDalCPSAction: MongoDal
            +MongoDalBPSUser: MongoDal
            +MongoDalServices: MongoDal
            +BpsCalls: BpsCallsInterface
        }
        
        class MongoDal<T> {
            +Create()
            +Update()
            +Delete()
            +FindByID()
            +Find()
            +RunInTransaction()
        }
        
        class BpsCalls {
            +CreateUser()
            +UpdateUser()
            +GetUser()
        }
    }
}

package "Infrastructure" <<Infrastructure>> {
    class MongoDBClient {
        +Connect()
        +Disconnect()
        +GetDatabase()
    }
    
    class MinioClient {
        +UploadFile()
        +DownloadFile()
        +DeleteFile()
    }
    
    class JWTToken {
        +GenerateToken()
        +ValidateToken()
        +ExtractClaims()
    }
    
    class KeyGenerator {
        +GenerateKey()
        +Encrypt()
        +Decrypt()
    }
}

