@startuml CBE Super App CPS Action - Class Diagram

!define RECTANGLE class

skinparam class {
    BackgroundColor<<Main>> LightBlue
    BackgroundColor<<Domain>> LightGreen
    BackgroundColor<<Application>> LightYellow
    BackgroundColor<<Adapter>> LightCyan
    BackgroundColor<<Infrastructure>> LightGray
    BackgroundColor<<Entity>> White
    BorderColor Black
    ArrowColor Black
}

package "Main Application" <<Main>> {
    class Main {
        +main()
    }
    
    class Initiator {
        +Initiator()
        -InitConfig()
        -InitMongo()
        -InitMinio()
        -InitPersistence()
        -InitDomain()
        -InitApplication()
        -InitAdapter()
        -InitRoutes()
    }
}

package "Domain Layer" <<Domain>> {
    package "CPS Actions" {
        class CPSAction {
            +ID: string
            +ActionCode: string
            +UniqueID: string
            +MakerID: string
            +MakerName: string
            +Department: string
            +ActionStatus: ActionStatus
            +ActionType: ActionType
            +RequestAction: RequestAction
            +CreatedAt: time.Time
            +LastModifiedAt: time.Time
        }
        
        enum ActionStatus {
            PENDING
            APPROVED
            REJECTED
        }
        
        enum ActionType {
            CREATE
            UPDATE
            DELETE
        }
        
        enum RequestAction {
            USER
            PERMISSION_GROUP
            DEPARTMENT
            BPS_USER
            DISABLE_BPS_USER
        }
        
        class CPSActionService {
            <<interface>>
            +CreateCPSAction()
            +UpdateCPSAction()
            +ApproveCPSAction()
            +RejectCPSAction()
            +GetCPSActionsByDepartment()
            +GetCPSActionByID()
            +RunInTransaction()
        }
        
        class CPSActionRepository {
            <<interface>>
            +CreateCPSAction()
            +UpdateCPSAction()
            +ApproveCPSAction()
            +RejectCPSAction()
            +GetCPSActionsByDepartment()
            +GetCPSActionByID()
            +RunInTransaction()
        }
    }
    
    package "Account Management" {
        class AccountBlock {
            +ID: string
            +AccountNumber: string
            +BlockReason: string
            +Status: string
            +CreatedAt: time.Time
        }
        
        class AccountBlockService {
            <<interface>>
            +CreateAccountBlock()
            +UpdateAccountBlock()
            +GetAccountBlock()
            +GetAccountBlocks()
        }
        
        class AccountBlockRepository {
            <<interface>>
            +CreateAccountBlock()
            +UpdateAccountBlock()
            +GetAccountBlock()
            +GetAccountBlocks()
        }
        
        class AccountValidation {
            +ID: string
            +AccountNumber: string
            +ValidationRule: string
            +Status: string
            +CreatedAt: time.Time
        }
        
        class AccountValidationService {
            <<interface>>
            +ValidateAccount()
            +GetValidationRules()
            +UpdateValidationRule()
        }
        
        class AccountValidationRepository {
            <<interface>>
            +ValidateAccount()
            +GetValidationRules()
            +UpdateValidationRule()
        }
    }
    
    package "User Management" {
        class CPSUser {
            +ID: string
            +UserCode: string
            +FullName: string
            +PhoneNumber: string
            +Department: string
            +Status: string
        }
        
        class CPSUserService {
            <<interface>>
            +CreateUser()
            +UpdateUser()
            +GetUserByID()
            +GetUsersByDepartment()
        }
        
        class BPSUser {
            +ID: string
            +UserCode: string
            +FullName: string
            +PhoneNumber: string
            +Department: string
        }
        
        class BPSUserService {
            <<interface>>
